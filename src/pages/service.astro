      { name: "웹 데이터 수집 (크롤러)", values: ["공개 사이트 1곳 (비로그인 기준)", "로그인 필요한 사이트 (세션 유지)", "대용량 분산 수집 및 아이피 우회"] },
      { name: "외부 알림 연동", values: ["-", "✓ (카카오 알림톡/텔레그램)", "✓ (실시간 채널 알림 커스텀)"] },
      { name: "구동 환경", values: ["로컬 단일 실행기 (원클릭 파일)", "로컬 간이 대시보드 프로그램", "클라우드 서버 24시간 자동 구동"] },
      { name: "연동 외부 채널 수", values: ["1개 기본 연계", "최대 3개 연계", "제한 없음 (무제한 연동)"] },
