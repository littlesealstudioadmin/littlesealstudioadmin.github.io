      { name: "데이터 관리 구조", values: ["기본 데이터 관리 (추가/수정/삭제)", "다차원 관계형 매핑 데이터", "대용량 트랜잭션 및 자동 백업 설계"] },
      { name: "사용자 로그인 및 권한", values: ["단일 관리자 계정 제공", "다중 계정 및 권한 분리 (관리자/직원)", "역할별 상세 권한 분기 및 접근 로그"] },
      { name: "데이터베이스 (DB)", values: ["구글시트 또는 초경량 DB", "상용 클라우드 데이터베이스", "독립형 전용 데이터베이스 최적화"] },
