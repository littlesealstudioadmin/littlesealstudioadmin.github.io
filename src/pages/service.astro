<style>
    /* Hide scrollbar for Chrome, Safari and Opera */
    #pricing-carousel::-webkit-scrollbar {
        display: none;
    }
    /* Hide scrollbar for IE, Edge and Firefox */
    #pricing-carousel {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
</style>

<script define:vars={{ specData }}>
    function initCarousel() {
        const carousel = document.getElementById('pricing-carousel');
        const cards = carousel?.querySelectorAll('[data-index]');
        const indicators = document.querySelectorAll('[data-indicator]');
        const countDisplay = carousel?.previousElementSibling?.querySelector('.font-mono');
        
        const specTableBody = document.getElementById('spec-table-body');
        const specTableHeader = document.getElementById('spec-table-header');
        const specTableTitle = document.getElementById('spec-table-title');

        if (!carousel || !cards || cards.length === 0) return;

        // Service ID Mapping
        const serviceIds = ['website', 'automation', 'erp', 'flutter'];
        let currentServiceId = 'website';

        // Initialize Cards
        cards.forEach((card, idx) => {
            const serviceId = serviceIds[idx];
            card.setAttribute('data-service-id', serviceId);
            card.style.cursor = 'pointer';

            // Click listener to toggle active card and render spec table
            card.addEventListener('click', () => {
                currentServiceId = serviceId;
                updateCardVisuals();
                renderSpecTable(currentServiceId);

                // Smooth scroll into view
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            });
        });

        function updateCardVisuals() {
            cards.forEach((c, i) => {
                const sId = serviceIds[i];
                
                if (sId === currentServiceId) {
                    c.classList.add('border-foreground', 'bg-foreground/[0.04]', 'opacity-100');
                    c.classList.remove('opacity-40', 'grayscale-[40%]', 'border-border');
                } else {
                    c.classList.remove('border-foreground', 'bg-foreground/[0.04]', 'opacity-100');
                    c.classList.add('opacity-40', 'grayscale-[40%]', 'border-border');
                }
            });
        }

        // Run initial visual state
        updateCardVisuals();

        // Swipe Carousel Indicator Observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const index = parseInt(entry.target.getAttribute('data-index') || '0', 10);
                    
                    indicators.forEach((ind, idx) => {
                        if (idx === index) {
                            ind.classList.add('bg-foreground');
                            ind.classList.remove('bg-transparent');
                        } else {
                            ind.classList.remove('bg-foreground');
                            ind.classList.add('bg-transparent');
                        }
                    });

                    if (countDisplay) {
                        countDisplay.textContent = `${index + 1} / 4`;
                    }
                }
            });
        }, {
            root: carousel,
            threshold: 0.6
        });

        cards.forEach(card => observer.observe(card));

        // Render Table function
        function renderSpecTable(serviceId) {
            const data = specData[serviceId];
            if (!data) return;

            // Title
            if (specTableTitle) {
                specTableTitle.textContent = `${data.title} - 세부 스펙 비교`;
            }

            // Header (Tiers)
            if (specTableHeader) {
                specTableHeader.innerHTML = `
                    <tr class="bg-muted font-mono text-xs uppercase text-foreground border-b border-border">
                        <th class="p-3 border-r border-border min-w-[180px] md:min-w-[220px] whitespace-nowrap">제공 기능 및 스펙</th>
                        ${data.tiers.map((tier, idx) => `
                            <th class="p-3 border-r last:border-r-0 border-border text-center whitespace-nowrap">
                                <div class="font-bold text-sm text-foreground">${tier.name}</div>
                                <div class="font-mono text-xs text-muted-foreground mt-0.5">${tier.price}</div>
                            </th>
                        `).join('')}
                    </tr>
                `;
            }

            // Body (Features)
            if (specTableBody) {
                specTableBody.innerHTML = data.features.map(feature => `
                    <tr class="hover:bg-muted/5 transition-colors">
                        <td class="p-3 border-r border-border font-sans font-bold whitespace-nowrap">${feature.name}</td>
                        ${feature.values.map(val => {
                            const isCheck = val === '✓' || val.startsWith('✓');
                            const isDash = val === '-';
                            const textClass = isCheck ? 'text-foreground font-bold' : isDash ? 'text-muted-foreground/30' : 'text-foreground/90';
                            return `<td class="p-3 border-r last:border-r-0 border-border text-center whitespace-nowrap ${textClass}">${val}</td>`;
                        }).join('')}
                    </tr>
                `).join('');
            }
        }

        // Run render initially
        renderSpecTable(currentServiceId);
    }

    // Astro transition support
    document.addEventListener('astro:page-load', initCarousel);
    // Initial run
    initCarousel();
</script>
