---
import IndexLayout from "@/layouts/IndexLayout.astro";
import IndexHeader from "@/components/static/IndexHeader.astro";
import { RiMailLine, RiKakaoTalkFill, RiGitMergeLine, RiUserHeartLine, RiShieldUserLine, RiCommandLine } from "@remixicon/react";
import site_config from "@/site-config.json";

const emailItem = site_config.introduction.subHeadingItems.find(item => item.type === "mail");
const emailUrl = emailItem?.url ?? "mailto:littlesealstudio@gmail.com";

const kakaoItem = site_config.introduction.socialItems.find(item => item.type === "kakaotalk");
const kakaoUrl = kakaoItem?.url ?? "https://open.kakao.com";

const pricingData = [
  {
    title: "심플 랜딩 페이지 / 브랜드 홈페이지",
    price: "30만 원 ~",
    duration: "1~2주",
    scope: "로딩 속도가 1초 미만인 고성능 홈페이지 및 랜딩 페이지 제작",
    iconName: "UserHeart",
    features: [
      "단일 페이지 (1개 스크롤 화면) 기준",
      "4~5개 논리적 섹션 구성",
      "전화/이메일/카카오톡 채널 연동",
      "반응형 모바일 최적화 및 검색 등록",
      "Astro, React 기반 고성능 페이지 구축"
    ]
  },
  {
    title: "업무 자동화 도구 (매크로 / 크롤러)",
    price: "50만 원 ~",
    duration: "1~2주",
    scope: "반복적인 단순 컴퓨터 업무를 클릭 한 번으로 가공하는 프로그램",
    iconName: "CommandLine",
    features: [
      "동일한 양식의 엑셀 파일 1종 자동 변환",
      "공개 웹사이트 1곳 정보 자동 수집 (크롤러)",
      "단일 플랫폼 API 데이터 연계 1개",
      "비개발자 실행용 간편 실행기 제공",
      "로그인이나 차단 우회 없는 사이트 기준"
    ]
  },
  {
    title: "소규모 관리 도구 / 미니 ERP",
    price: "100만 원 ~",
    duration: "2~3주",
    scope: "매장 및 소호 관리에 최적화된 소형 어드민 대시보드",
    iconName: "ShieldUser",
    features: [
      "최대 3개 화면 (대시보드 + 목록 + 등록)",
      "최대 3종의 핵심 데이터 관리 구조",
      "비밀번호 로그인 보안 게이트 제공",
      "목록 데이터 엑셀/문서 다운로드",
      "구글 스프레드시트 또는 초경량 데이터베이스 연동"
    ]
  },
  {
    title: "Flutter 멀티플랫폼 웹·앱 MVP",
    price: "150만 원 ~",
    duration: "3~4주",
    scope: "단일 코드로 iOS와 Android 환경에서 구동되는 고성능 시제품",
    iconName: "GitMerge",
    features: [
      "최대 5개 핵심 앱 화면 구성",
      "안드로이드, iOS 앱 및 모바일웹 동시 빌드",
      "간이 이메일 회원가입 및 로그인",
      "정보 리스트 조회 및 상세 페이지 이동",
      "1:1 건의사항 작성 및 관리자 전달"
    ]
  }
];

