---
import Section from "@/components/static/Section.astro";
import Introduction from "@/components/static/Introduction.astro";
import site_config from "@/site-config.json";
import FeaturedBlog from "@/components/static/FeaturedBlog.astro";
import FeaturedProjects from "@/components/static/FeaturedProjects.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="리틀실스튜디오 | 앱과 웹을 만드는 1인 개발 스튜디오" description="공기업 전산직 10년 차 개발자가 운영하는 1인 개발 스튜디오입니다. 낚시 기록 앱 피싱레코드를 비롯해 직접 기획하고 만든 앱·웹 프로젝트와 개발 기록을 담았습니다." image="/og/default.png">
    <div transition:animate="fade" class="pt-10">
        {/* Introduction Section */}
        {site_config.bIntroduction && <Introduction />}

        {
            site_config.featured.important === "projects" ? (
                <>
                    <FeaturedProjects />
                    <FeaturedBlog />
                </>
            ) : (
                <>
                    <FeaturedBlog />
                    <FeaturedProjects />
                </>
            )
        }
    </div>
</BaseLayout>
