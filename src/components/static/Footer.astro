---
import site_config from "@/site-config.json";
const isDev = import.meta.env.DEV;
---

<footer class="mx-auto font-mono antialiased bg-background max-w-4xl text-foreground select-none sticky bottom-0 z-0">
    <div class="flex flex-col sm:flex-row items-center justify-between px-3 py-2 gap-1 sm:gap-0">
        <div class="flex items-center gap-4">
            <p class="text-xs sm:text-sm text-muted-foreground flex items-center gap-1.5 flex-wrap justify-center sm:justify-start text-center sm:text-left">
                <span>&copy; {new Date().getFullYear()} {site_config.introduction.heading}. All rights reserved.</span>
                {isDev && (
                    <>
                        <span class="text-muted-foreground/30 select-none hidden sm:inline">|</span>
                        <a href="/admin" class="hover:text-foreground text-[10px] sm:text-xs text-muted-foreground transition-colors font-mono uppercase tracking-wider">admin</a>
                    </>
                )}
            </p>
        </div>
        <div>
            <p class="text-xs sm:text-sm text-muted-foreground text-center sm:text-right">
                powered by <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-foreground transition-colors">Astro</a>
                <span class="text-muted-foreground/80">&</span>
                <a href="https://astro.build/themes/details/ryze/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-foreground transition-colors">Ryze</a>
            </p>
        </div>
    </div>
</footer>
