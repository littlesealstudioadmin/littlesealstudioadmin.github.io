---
import site_config from "@/site-config.json";
import projectsConfig from "@/projects-config.json";
import { parse } from "date-fns";
import { getImage } from "astro:assets";
import { FeaturedProjectCard } from "../client/FeaturedProjectCard";
import type { projectConfig } from "@/lib/types";
import type { ImageMetadata } from "astro";
import { RiArrowRightUpLine } from "@remixicon/react";

const projects = projectsConfig
    .filter((item) => item.id !== "project-id-template")
    .sort((a, b) => {
        const dateA = parse(a.data.date, "dd-MM-yyyy", new Date());
        const dateB = parse(b.data.date, "dd-MM-yyyy", new Date());
        return dateB.getTime() - dateA.getTime();
    });

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>("@/assets/projects/*/*.{png,jpg,jpeg,webp,gif,avif}", { eager: true });

const enriched = await Promise.all(
    projects.map(async (item) => {
        const matches = Object.entries(imageModules)
            .filter(([path]) => path.includes(`/assets/projects/${item.id}/`))
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([, mod]) => mod.default);

        let heroImage: string | undefined;
        if (matches.length > 0) {
            const optimized = await getImage({ src: matches[0], width: 600 });
            heroImage = optimized.src;
        }

        return { ...item, heroImage };
    }),
);
---

{
    site_config.featured.projects.visible && projects.length > 0 && (
        <section class="bg-background border border-border p-6 mt-10">
            <a href="/projects" class="flex items-center justify-start group w-fit gap-2 select-none">
                <span class="text-muted-foreground group-hover:text-secondary-foreground font-sans animation">직접 기획하고 개발한 주요 프로젝트</span>
                <RiArrowRightUpLine className="size-0 group-hover:size-4 scale-0 group-hover:scale-100 opacity-0 group-hover:opacity-100 animation" />
            </a>
            <div class="mt-6">
                <FeaturedProjectCard items={enriched as (projectConfig & { heroImage?: string })[]} client:load />
            </div>
        </section>
    )
}
